---
import SectionHeading from "./SectionHeading.astro";

interface Patent {
  title?: string;
  title_zh?: string;
  title_en?: string;
  inventors: string | string[];
  type: string;
  application: string;
  date: string;
  language?: "zh" | "en";
}

interface Award {
  date: string;
  title: string;
  detail: string;
}

interface Props {
  patents: Patent[];
  awards: Award[];
}

const { patents, awards } = Astro.props;

const escapeHtml = (value: string) =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#39;");

const patentInventors = (inventors: Patent["inventors"]) =>
  Array.isArray(inventors) ? inventors : inventors.split(",").map((name) => name.trim()).filter(Boolean);

const renderInventorsHtml = (inventors: Patent["inventors"]) =>
  patentInventors(inventors)
    .map((inventor) => {
      const name = escapeHtml(inventor);
      return inventor === "杨进" || inventor === "Jin Yang" ? `<strong class="author-me">${name}</strong>` : name;
    })
    .join(", ");

const patentMainTitle = (patent: Patent) =>
  patent.language === "en" ? (patent.title_en || patent.title || patent.title_zh) : (patent.title_zh || patent.title || patent.title_en);

const patentSubTitle = (patent: Patent) =>
  patent.language === "en" ? patent.title_zh : patent.title_en;
---

<div class="compact-stack">
  <section class="section-block" aria-labelledby="patents-heading">
    <SectionHeading id="patents" title="Patents" />
    <div class="patent-list content-card">
      {patents.map((patent) => (
        <article class="patent-item">
          <p class="patent-line">
            <span class="patent-type">{patent.type}</span>
            <time>{patent.date}.</time>
            <span class="patent-inventors" set:html={`${renderInventorsHtml(patent.inventors)}.`} />
            <span class="patent-title">{patentMainTitle(patent)}.</span>
            <span class="patent-number">No. {patent.application}</span>
          </p>
          {patentSubTitle(patent) && <p class="patent-alt-title">{patentSubTitle(patent)}</p>}
        </article>
      ))}
    </div>
  </section>
  <section class="section-block" aria-labelledby="awards-heading">
    <SectionHeading id="awards" title="Awards" />
    <div class="compact-card content-card">
      {awards.map((award) => (
        <article>
          <span>{award.date}</span>
          <h3>{award.title}</h3>
          <p>{award.detail}</p>
        </article>
      ))}
    </div>
  </section>
</div>
