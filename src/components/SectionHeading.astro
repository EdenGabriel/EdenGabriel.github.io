---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
}

const { id, title, subtitle } = Astro.props;
---

<div class="section-heading" id={id}>
  <div>
    <p class="section-kicker">{id.replace("-", " ")}</p>
    <h2>{title}</h2>
  </div>
  {subtitle && <p>{subtitle}</p>}
</div>
