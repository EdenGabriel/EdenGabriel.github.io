---
import SectionHeading from "./SectionHeading.astro";

interface LinkItem {
  label: string;
  url: string;
}

interface Publication {
  title: string;
  category?: "survey" | "research";
  authors: string;
  my_role?: string;
  status?: string;
  venue_under_review?: string;
  venue: string | number;
  venueShort?: string;
  image?: string;
  links?: LinkItem[];
}

interface PublicationYear {
  year: number;
  items: Publication[];
}

interface PublicationCategory {
  id: string;
  title: string;
  groups: { year?: number; items: Publication[] }[];
}

interface Props {
  groups: PublicationYear[];
  scholarUrl?: string;
}

const { groups, scholarUrl } = Astro.props;

const surveys = groups.flatMap((group) => group.items.filter((paper) => paper.category === "survey"));
const researchGroups = groups
  .map((group) => ({
    year: group.year,
    items: group.items.filter((paper) => paper.category !== "survey"),
  }))
  .filter((group) => group.items.length > 0)
  .sort((a, b) => b.year - a.year);

const categories: PublicationCategory[] = [
  {
    id: "publications-surveys",
    title: "Survey Papers",
    groups: surveys.length > 0 ? [{ items: surveys }] : [],
  },
  {
    id: "publications-research",
    title: "Research Papers",
    groups: researchGroups,
  },
];

const hiddenLinkLabels = new Set(["bibtex", "related project"]);

const visibleLinks = (links: LinkItem[] = []) =>
  links.filter((link) => !hiddenLinkLabels.has(link.label.toLowerCase()));

const venueText = (paper: Publication) =>
  paper.venueShort ? `${paper.venue} (${paper.venueShort})` : paper.venue;

const reviewStatus = (paper: Publication) => paper.venue_under_review || paper.status;

const renderAuthors = (authors: string) =>
  authors.split(",").map((author) => {
    const name = author.trim();
    return {
      name,
      isMe: name === "Jin Yang",
    };
  });

const escapeHtml = (value: string) =>
  value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#39;");

const renderAuthorsHtml = (authors: string) =>
  renderAuthors(authors)
    .map((author) => {
      const name = escapeHtml(author.name);
      return author.isMe ? `<strong class="author-me">${name}</strong>` : name;
    })
    .join(", ");
---

<section class="section-block" aria-labelledby="publications-heading">
  <SectionHeading id="publications" title="Publications" />
  <div class="publication-list content-card">
    <p class="publications-note">
      Selected Publications. The list may not be up-to-date. Please find my latest publications on
      {scholarUrl ? <a href={scholarUrl} target="_blank" rel="noreferrer">Google Scholar</a> : "Google Scholar"}.
    </p>
    {
      categories.filter((category) => category.groups.length > 0).map((category) => (
        <section class="publication-category" aria-labelledby={`${category.id}-heading`}>
          <h3 class="publication-category-title" id={`${category.id}-heading`}>{category.title}</h3>
          {category.groups.map((group) => {
            const PaperHeading = group.year === undefined ? "h4" : "h5";

            return (
              <div class:list={["publication-group", { "publication-year-group": group.year !== undefined }]}>
                {group.year !== undefined && (
                  <h4 class="publication-year-heading" id={`publications-year-${group.year}`}>{group.year}</h4>
                )}
                {group.items.map((paper) => {
                  const links = visibleLinks(paper.links);
                  const primaryLink = links[0]?.url;
                  const isExternal = primaryLink?.startsWith("http");

                  return (
                    <article class:list={["publication-item", { "publication-item--text-only": !paper.image }]}>
                      {paper.image && (
                        <a class="publication-thumb" href={primaryLink || "#"} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noreferrer" : undefined}>
                          <img src={paper.image} alt={`${paper.title} thumbnail`} loading="lazy" />
                        </a>
                      )}
                      <div class="publication-body">
                        <PaperHeading class="paper-title">{paper.title}</PaperHeading>
                        <p class="paper-authors" set:html={renderAuthorsHtml(paper.authors)} />
                        <p class="paper-venue">
                          <span>{venueText(paper)}</span>
                          {paper.my_role && <span class="paper-role-badge">{paper.my_role}</span>}
                        </p>
                        {(reviewStatus(paper) || links.length > 0) && (
                          <div class="paper-links">
                            {reviewStatus(paper) && <span class="paper-status-badge">{reviewStatus(paper)}</span>}
                            {links.map((link) => (
                              <a href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined} rel={link.url.startsWith("http") ? "noreferrer" : undefined}>{link.label}</a>
                            ))}
                          </div>
                        )}
                      </div>
                    </article>
                  );
                })}
              </div>
            );
          })}
        </section>
      ))
    }
  </div>
</section>
