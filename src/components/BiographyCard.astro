---
interface Props {
  biography: {
    paragraphs: string[];
    interests: string[];
  };
}

const { biography } = Astro.props;
---

<section class="bio-card content-card" aria-labelledby="biography-title">
  <div>
    <p class="section-kicker">Biography</p>
    <h2 id="biography-title">About Me</h2>
  </div>
  <div class="bio-text">
    {biography.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
  <div class="interest-list">
    {biography.interests.map((interest) => <span>{interest}</span>)}
  </div>
</section>
