---
interface LinkItem {
  label: string;
  url: string;
  icon: string;
}

interface Props {
  profile: {
    name: string;
    chineseName: string;
    title: string;
    affiliation: string;
    location: string;
    avatar: string;
    email: string;
    lastUpdated: string;
    visitorMapScriptId?: string;
    visitorMapScriptUrl?: string;
    visitorMapEmbedUrl?: string;
    visitorMapImage?: string;
    visitorMapUrl?: string;
    links: LinkItem[];
  };
}

const { profile } = Astro.props;

const visitorMapScriptHtml = profile.visitorMapScriptUrl
  ? `<script type="text/javascript" id="${profile.visitorMapScriptId || "mapmyvisitors"}" src="${profile.visitorMapScriptUrl}"></script>`
  : "";

---

<aside class="profile-panel">
  <img class="profile-photo" src={profile.avatar} alt={`${profile.name} portrait`} loading="eager" />
  <div class="profile-copy">
    <h1>{profile.title} {profile.name}</h1>
    <p class="chinese-name">{profile.chineseName}</p>
  </div>

  <div class="profile-links" aria-label="Academic links">
    {
      profile.links.map((link) => (
        <a href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined} rel={link.url.startsWith("http") ? "noreferrer" : undefined}>
          <span class={`link-mark ${link.icon.toLowerCase()}`} aria-hidden="true">
            {link.icon === "Mail" ? (
              <svg viewBox="0 0 24 18" focusable="false">
                <path fill="#4285F4" d="M2 18h4V7.7L0 3.2V16c0 1.1.9 2 2 2Z" />
                <path fill="#34A853" d="M18 18h4c1.1 0 2-.9 2-2V3.2l-6 4.5V18Z" />
                <path fill="#FBBC04" d="M18 0v7.7l6-4.5V2c0-1.6-1.8-2.5-3.1-1.5L18 2.7Z" />
                <path fill="#EA4335" d="M6 7.7V0l6 4.5L18 0v7.7l-6 4.5Z" />
                <path fill="#C5221F" d="M0 2v1.2l6 4.5V0L3.1.5C1.8-.5 0 .4 0 2Z" />
              </svg>
            ) : link.icon === "Scholar" ? (
              <svg viewBox="0 0 24 24" focusable="false">
                <circle cx="12" cy="12" r="11" fill="#4285F4" />
                <path fill="#fff" d="M5.2 10.2 12 5.8l6.8 4.4L12 14.4 5.2 10.2Z" />
                <path fill="#fff" d="M8 13.1c1.8 1.5 6.2 1.5 8 0v3.2c-1.8 1.7-6.2 1.7-8 0v-3.2Z" />
                <path fill="#185ABC" d="M18.8 10.2v5.1" stroke="#185ABC" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            ) : link.icon === "GitHub" ? (
              <svg viewBox="0 0 16 16" focusable="false">
                <path fill="#181717" d="M8 .2a8 8 0 0 0-2.5 15.6c.4.1.5-.2.5-.4v-1.5c-2 .4-2.5-.5-2.7-1-.1-.3-.6-1-.9-1.2-.3-.2-.8-.7 0-.7.7 0 1.2.7 1.4 1 .8 1.3 2 .9 2.5.7.1-.6.3-.9.6-1.1-1.8-.2-3.6-.9-3.6-4 0-.9.3-1.6.8-2.2-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8.6-.2 1.3-.3 2-.3s1.4.1 2 .3c1.5-1 2.2-.8 2.2-.8.4 1.1.2 1.9.1 2.1.5.6.8 1.3.8 2.2 0 3.1-1.9 3.8-3.6 4 .3.3.6.8.6 1.6v2.4c0 .2.1.5.6.4A8 8 0 0 0 8 .2Z" />
              </svg>
            ) : link.icon === "CSDN" ? (
              <svg viewBox="0 0 42 18" focusable="false">
                <text x="1" y="13.5" fill="#C92027" font-size="12" font-weight="900" font-family="Arial, Helvetica, sans-serif">CSDN</text>
              </svg>
            ) : (
              link.icon.slice(0, 2)
            )}
          </span>
          {link.label}
        </a>
      ))
    }
  </div>

  <div class="visitor-card" aria-label="Visitor map">
    {profile.visitorMapScriptUrl ? (
      <div class="visitor-map-script" set:html={visitorMapScriptHtml} />
    ) : profile.visitorMapEmbedUrl ? (
      <iframe class="visitor-map-frame" src={profile.visitorMapEmbedUrl} title="Visitor map" loading="lazy"></iframe>
    ) : profile.visitorMapImage ? (
      profile.visitorMapUrl ? (
        <a class="visitor-map-link" href={profile.visitorMapUrl} target="_blank" rel="noreferrer">
          <img class="visitor-map-image" src={profile.visitorMapImage} alt="Visitor map" loading="lazy" />
        </a>
      ) : (
        <img class="visitor-map-image" src={profile.visitorMapImage} alt="Visitor map" loading="lazy" />
      )
    ) : (
      <div class="visitor-map-empty">
        <svg viewBox="0 0 260 126" role="img" aria-label="Visitor map placeholder">
          <text class="visitor-map-title" x="8" y="16">Visitors</text>
          <g class="visitor-world">
            <path d="M42 42c13-10 27-10 39-4 8 4 16 4 24 2 7-2 13 2 16 8-17 8-31 11-48 8-8-2-19 2-31 11-10-5-11-17 0-25Z" />
            <path d="M125 35c16-5 39-5 53 3 11 7 9 20-4 26-12 6-25 4-37 0-10-4-21-2-31 2-6-13 2-26 19-31Z" />
            <path d="M171 65c12-4 30-1 41 7 10 8 9 20-3 25-14 6-33 4-47-4-11-7-8-23 9-28Z" />
            <path d="M101 72c13-4 29-2 37 7 8 9 3 22-10 27-14 5-32 1-41-8-9-10-2-22 14-26Z" />
          </g>
          <g class="visitor-dots">
            <circle cx="63" cy="51" r="2.5" />
            <circle cx="82" cy="58" r="2.3" />
            <circle cx="136" cy="50" r="3.2" />
            <circle cx="149" cy="57" r="2.6" />
            <circle cx="174" cy="75" r="2.8" />
            <circle cx="192" cy="84" r="2.4" />
            <circle cx="211" cy="82" r="2.4" />
            <circle cx="111" cy="87" r="2.2" />
            <circle cx="221" cy="58" r="2.2" />
          </g>
          <text class="visitor-stat" x="8" y="108">Today --</text>
          <text class="visitor-divider" x="64" y="108">|</text>
          <text class="visitor-stat" x="78" y="108">Total --</text>
          <text class="visitor-note" x="8" y="122">* Map updates daily</text>
        </svg>
      </div>
    )}
  </div>

  <div class="profile-updated">
    <span>Last updated</span>
    <time>{profile.lastUpdated}</time>
  </div>
</aside>

