---
import SectionHeading from "./SectionHeading.astro";

interface NewsItem {
  date: string;
  type?: "paper" | "award" | "talk" | string;
  icon?: string;
  title: string;
  link?: {
    label: string;
    url: string;
  };
  links?: {
    label: string;
    url: string;
  }[];
}

interface Props {
  news: NewsItem[];
}

const { news } = Astro.props;

const formatDate = (value: string) => {
  const [year, month] = value.split("-");
  return year && month ? `${month}/${year}` : value;
};

const itemLinks = (item: NewsItem) => item.links ?? (item.link ? [item.link] : []);
---

<section class="section-block" aria-labelledby="news-heading">
  <SectionHeading id="news" title="News" />
  <div class="news-card content-card">
    <ul class="news-list">
      {
        news.map((item) => (
          <li class="news-item">
            {item.icon && <span class="news-icon" aria-hidden="true">{item.icon}</span>}
            <time class={`news-date ${item.type ?? "general"}`} datetime={item.date}>{formatDate(item.date)}</time>
            <p>
              {item.title}
              {itemLinks(item).length > 0 && (
                <>
                  {" "}
                  {itemLinks(item).map((link) => (
                    <a href={link.url} target="_blank" rel="noreferrer">[{link.label}]</a>
                  ))}
                </>
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
