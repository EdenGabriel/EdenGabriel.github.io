---
import SectionHeading from "./SectionHeading.astro";

interface Props {
  biography: {
    paragraphs: string[];
    interests: string[];
  };
}

const { biography } = Astro.props;
---

<section class="section-block" aria-labelledby="biography-heading">
  <SectionHeading id="biography" title="Biography" />
  <div class="bio-card content-card">
    <div class="bio-text">
      {biography.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
    </div>
    <div class="interest-list">
      {biography.interests.map((interest) => <span>{interest}</span>)}
    </div>
  </div>
</section>
